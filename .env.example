# ==================================================
# FRONTEND DEPLOYMENT ENVIRONMENT VARIABLES (NETLIFY / VITE)
# ==================================================
# Base URL of your deployed Express backend API service (e.g. https://prescan-backend.onrender.com)
# Leave blank during local development when running frontend and backend together on port 3000.
VITE_API_BASE_URL=https://YOUR-BACKEND-URL.com

# ==================================================
# BACKEND DEPLOYMENT ENVIRONMENT VARIABLES (EXPRESS / NODE)
# ==================================================
# GEMINI_API_KEY: Required for Gemini AI media analysis & transcription.
# MUST remain server-side. NEVER prefix with VITE_.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# FRONTEND_URL or APP_URL: The URL of your deployed Netlify frontend application.
# Used for CORS configuration on the backend.
FRONTEND_URL=https://YOUR-NETLIFY-SITE.netlify.app
APP_URL=https://YOUR-NETLIFY-SITE.netlify.app

# Optional server PORT override (Node hosting providers like Render/Cloud Run inject this)
PORT=3000

# STRIPE BILLING & SUBSCRIPTIONS
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=



